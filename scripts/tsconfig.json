{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@/*": ["../apps/web/src/*"] }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}

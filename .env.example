# Spotter — environment variables. Copy to `.env` (root) and `apps/web/.env.local`. Never commit real values.
# REQ = required for the review-1 demo · OPT = optional / later.

# ───────── Supabase (region: South Asia — Mumbai) ─────────
# Dashboard → your project → Connect / Project Settings → API Keys.
# Uses the NEW key model: publishable (sb_publishable_…) and secret (sb_secret_…), not legacy anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=                 # REQ  https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # REQ  sb_publishable_…  (safe in browser; RLS protects data)
SUPABASE_SECRET_KEY=                      # REQ  sb_secret_…  (server only; bypasses RLS — never expose)
SUPABASE_PROJECT_REF=                     # OPT  the <project-ref> part of the URL (derivable; handy for CLI)
# Account → Access Tokens (supabase.com/dashboard/account/tokens) → Generate new token. Used by Supabase CLI + MCP.
SUPABASE_ACCESS_TOKEN=                    # REQ  sbp_…
SUPABASE_DB_PASSWORD=                     # REQ  the database password you set when creating the project

# ───────── Groq (all LLM work: chat, vision, speech-to-text) ─────────
# console.groq.com → sign in → API Keys → Create API Key. One key per task keeps usage visible;
# model IDs + free-tier limits: docs/research/15-groq-voice.md (verify multi-key terms there).
GROQ_API_KEY=                             # REQ  gsk_…  default key (chat / RAG answers)
GROQ_API_KEY_VISION=                      # OPT  photo understanding (falls back to GROQ_API_KEY)
GROQ_API_KEY_VOICE=                       # OPT  speech-to-text (falls back to GROQ_API_KEY)
GROQ_API_KEY_BACKUP=                      # OPT  used on rate-limit (429) errors

# ───────── Google Gemini (fallback when Groq hits its rate limit) ─────────
# aistudio.google.com → Get API key. Free tier; Google may use free-tier inputs → send synthetic data only.
# Name is the one @ai-sdk/google reads by default (verify at build time).
GOOGLE_GENERATIVE_AI_API_KEY=             # OPT (recommended)

# ───────── Pinecone (vector database for Ask Spotter) ─────────
# app.pinecone.io → sign up (Starter plan, free) → API Keys → Create API key. Free indexes live in AWS us-east-1.
PINECONE_API_KEY=                         # REQ
PINECONE_INDEX=spotter-kb                 # REQ  index name (we create it)

# ───────── Voyage AI (embeddings, incl. images/diagrams) ─────────
# voyageai.com → sign up → dashboard → API Keys. 200M free tokens + free image pixels (one-time grant).
VOYAGE_API_KEY=                           # REQ

# ───────── LlamaParse (PDF/manual parsing with tables) ─────────
# cloud.llamaindex.ai → sign up → API Keys. 10,000 free credits/month.
LLAMA_CLOUD_API_KEY=                      # OPT  (only for PDF ingestion; can run once, offline)

# ───────── Vercel AI Gateway (optional single key for many models) ─────────
# vercel.com → your team → AI Gateway → API Keys. Only if we route models through the gateway.
# AI_GATEWAY_API_KEY=                     # OPT

# ───────── Text-to-speech for Hindi alerts ─────────
# Provider decided in docs/research/15-groq-voice.md (Groq may not offer Hindi TTS). Placeholder:
# TTS_PROVIDER_API_KEY=                   # TBD

# ───────── Twilio (outbound voice alert calls) — existing trial account (~$5 credit) ─────────
# twilio.com/try-twilio → verify email + phone → Console dashboard shows Account SID + Auth Token.
# Buy/claim one trial number: Phone Numbers → Manage → Buy a number (voice-capable).
# TRIAL RULES: can only call VERIFIED numbers → Phone Numbers → Verified Caller IDs → add each demo phone.
# Enable India: Voice → Settings → Geo permissions → tick India.
# (Unverified: trial calls may play a Twilio trial preamble; confirm on the first test call.)
TWILIO_ACCOUNT_SID=                       # REQ  AC…
TWILIO_AUTH_TOKEN=                        # REQ
TWILIO_FROM_NUMBER=                       # REQ  E.164, e.g. +1…
DEMO_OPERATOR_PHONE=                      # REQ  E.164 verified number that plays "Ravi" (e.g. +91…)
DEMO_SUPERVISOR_PHONE=                    # REQ  E.164 verified number that plays "Anita"

# ───────── Telegram (supervisor alerts, SOS, ledger witness) ─────────
# In Telegram: @BotFather → /newbot → name → username ending in "bot" → copy token.
# Then the supervisor's phone opens the bot and presses Start (bots cannot message a user first);
# we read the chat id from getUpdates during setup.
TELEGRAM_BOT_TOKEN=                       # REQ  123456:ABC…
TELEGRAM_SUPERVISOR_CHAT_ID=              # REQ  numeric id (filled during setup)
TELEGRAM_WEBHOOK_SECRET=                  # REQ  any random 32+ chars [A-Za-z0-9_-] — we generate it

# ───────── Weather ─────────
# Open-Meteo: no key needed (free, non-commercial).

# ───────── Maps ─────────
# MapLibre + OpenStreetMap-based tiles: no key needed for the demo.
# NEXT_PUBLIC_MAPTILER_KEY=               # OPT nicer basemap: maptiler.com → Account → API keys (free tier)

# ───────── App ─────────
DEMO_DRIVER_SECRET=                       # REQ  random string guarding the hidden /demo control panel
